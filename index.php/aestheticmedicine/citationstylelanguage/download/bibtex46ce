@article{Rivera_Ollarves Ruiz_Rivera Pineda_Lugo_Hagel López_2026, title={Effectiveness of a combined approach using PDL and Q-switched 1064 Nd: YAG laser mode for the treatment of melasma lesions in Venezuelan female patients}, volume={12}, url={https://mattioli1885journals.com/index.php/aestheticmedicine/article/view/17899}, DOI={10.57662/am.2026.17899}, abstractNote={
Background: Melasma is a chronic hyperpigmentation disorder often presenting with a vascular component. Conventional therapies show variable efficacy and limited durability of results, highlighting the need for optimized treatment strategies. Objective: To evaluate the effectiveness of combined laser toning (Q-switched 1064 Nd:YAG) and pulsed dye laser (PDL, Candela Vbeam) for the treatment of vascularized melasma lesions. Methods: A total of 120 female patients aged 34–56 years with vascularized melasma underwent treatment and follow-up at baseline, 3-, 6-, and 12-months using VISIA Complexion Analysis. Standardized images (frontal, right, and left lateral) were obtained to assess percentile scores for brown spots (melasma) and red spots (telangiectatic erythema within melasma). Patients received eight weekly sessions of laser toning. Subgroups included: 26 patients treated with laser toning alone, 54 patients with PDL prior to laser toning, and 40 patients with PDL after laser toning. Results: Median VISIA percentiles for both brown and red spots significantly increased after treatment (p < 0.005), reflecting a reduction of vascularized melasma lesions. Improvement was most pronounced in patients receiving PDL before laser toning (p < 0.0001). The therapeutic effect of PDL followed by toning persisted for 12 months, whereas patients treated with laser toning alone showed diminished effects by 6 months (p < 0.05). Conclusions: The combination of PDL followed by Q-switched 1064 Nd:YAG laser toning is a safe and effective treatment for melasma with a vascular component, providing longer-lasting results compared to laser toning alone.
}, number={2}, journal={Aesthetic Medicine}, author={Rivera, Zulay and Ollarves Ruiz, Víctor and Rivera Pineda, Ingrid and Lugo, Dennis Alexander and Hagel López, Isabel}, year={2026}, month={Jul.}, pages={17899} }