@article{Kusuma_Pelupessy_Lisal_Masadah_Arifuddin_Zainuddin_2026, place={Fidenza, Italy}, title={Exploring ROS Proto-Oncogen 1 (ROS-1), a receptor tyrosine kinase expression in cervical cancer: A clinicopathological analysis}, volume={97}, url={https://mattioli1885journals.com/index.php/actabiomedica/article/view/18429}, DOI={10.23750/abm.2026.18429}, abstractNote={
Background : Cervical cancer remains a leading cause of cancer-related mortality among women, with persistent HPV infection as the primary risk factor. Despite advancements in prevention and treatment, diagnosis often occurs at later stages. The exploration of biomarkers in cervical cancer may offer valuable insights into disease progression and potential therapeutic targets. However, the role of biomarkers like ROS1 remains inadequately studied, warranting further investigation to better understand its therapeutic potential. Methods : This observational cross-sectional study involved 66 cervical cancer patients with a mean age of 47.14 ± 8.58 years. ROS1 expression was assessed using immunohistochemistry (IHC) on biopsy samples. Clinicopathological data, including cancer stage, histology, differentiation grade, and lymphovascular space invasion (LVSI), were collected. Statistical analysis was performed using the Chi-Square test and Mann-Whitney test to evaluate correlation between ROS1 expression and clinical factors. Results : ROS1 positivity was observed in 56.1% of patients. Significant associations were found between ROS1 expression and parity (p = 0.040), clinical stage (p = 0.028), and histological subtype (p = 0.007). Higher expression was notably linked to advanced stages and adenocarcinoma cases. Mann-Whitney analysis revealed a significant difference in ROS1 expression between squamous and non-squamous histologies (p = 0.0007). Conclusion : ROS1 expression is significantly correlated with disease progression in cervical cancer, particularly in adenocarcinoma subtypes. These findings suggest that ROS1 could serve as a valuable prognostic biomarker and a potential target for precision therapies in cervical cancer. Further studies are warranted to validate this and explore one as a therapeutic target.
}, number={4}, journal={Acta Biomedica Atenei Parmensis}, author={Kusuma, Nur Hikmah and Pelupessy, Nugraha Utama and Lisal, Lenny Maria and Masadah, Rina and Arifuddin, Sharvianty and Zainuddin, Andi Alfiann}, year={2026}, month={Aug.}, pages={18429} }