@article{Cigliano_Gorgoglione_Talamo_Cinelli_Pagliara_Pazienza_Guglielmi_2026, place={Fidenza, Italy}, title={Breast cancer seeding the needle tract after tru-cut needle biopsy (TCNB): Case report and literature review}, volume={97}, url={https://mattioli1885journals.com/index.php/actabiomedica/article/view/18812}, DOI={10.23750/abm.2026.18812}, abstractNote={
Needle tract seeding occurs when tumor cells are inadvertently planted along the path of a needle during biopsy. It’s a possible occurrence related to breast needle biopsy. Although the clinical significance of such dissemination is statistically not significant, theoretical risk factor to develop recorrent locoregional disease, following needle biopsy of suspicious lesions, is recognized. This study reports a right breast cancer seeding the needle tract case, after Tru-Cut needle biopsy (TCNB). 
}, number={4}, journal={Acta Biomedica Atenei Parmensis}, author={Cigliano, Federica and Gorgoglione, Annalisa and Talamo, Vincenza and Cinelli, Filomena and Pagliara, Martina Pia and Pazienza, Luca and Guglielmi, Giuseppe}, year={2026}, month={Aug.}, pages={18812} }