@article{Boffetta_Zaridze_Świątkowska_Pándics_Lissowska_Fabiánová_Field_Mates_Schejbalová_Foretova_et al._2026, title={Combined Occupational Exposure to Lead and Other Metals and Risk of Lung Cancer}, volume={117}, url={https://mattioli1885journals.com/index.php/lamedicinadellavoro/article/view/18905}, DOI={10.23749/mdl.2026.18905}, abstractNote={Background: The evidence linking occupational exposure to lead and cancer in humans is suggestive. Existing studies examine individual exposure to lead, ignoring the potential joint effects of mixed metal exposure. Methods:We analyzed the data of a case-control study of lung cancer conducted in seven European countries and comprising 2,861 cases and 2,936 controls, with a detailed assessment of occupational exposure to arsenic, cadmium, chromium (VI), and lead, to estimate the odds ratio (OR) of lung cancer for combined exposure to lead and these other carcinogenic metals, after adjustment for potential confounders. Results: The results suggested a synergism between lead and arsenic or cadmium: ORs were around 1.0 for lead alone and above 2.0 for combined exposure. No interaction was suggested between lead and chromium (VI). Conclusion: Our results provide suggestive evidence of a possible interaction between occupational exposure to lead, arsenic, or cadmium and lung cancer risk, and highlight the importance of considering mixed metal exposures in occupational epidemiology.
}, number={4}, journal={La Medicina del Lavoro}, author={Boffetta, Paolo and Zaridze, David and Świątkowska , Beata and Pándics, Tamás and Lissowska, Jolanta and Fabiánová, Eleonóra and Field , John K. and Mates, Dana and Schejbalová, Miriam and Foretova, Lenka and Janout, Vladimir and Mukheria, Anush and Yang, Chengfeng and Seyyedsalehi, Monireh Sadat}, year={2026}, month={Aug.}, pages={18905} }