@article{Mohanan_Annie Malathy_BasheerAhmed_Nellainayagam_2026, title={Intense pulsed light in treatment of pigmentary disorders in Indian skin- A Case Series}, volume={12}, url={https://mattioli1885journals.com/index.php/aestheticmedicine/article/view/16845}, DOI={10.57662/am.2026.16845}, abstractNote={
Introduction: Intense pulsed light (IPL) treatment has become very popular in India. However, there is limited literature regarding its use for pigmentary lesions in Indian skin. Objectives: To evaluate the safety and effectiveness of IPL in the treatment of pigmentary disorders in Indian patients. Methods: IPL treatment was offered to 11 Indian patients with pigmentary disorders. Results: Good outcomes were observed in patients with lentigines, freckles, and post-acne pigmentation. No serious adverse effects were reported. Conclusions: IPL appears to be a safe and effective treatment option for selected pigmentary disorders in Indian skin.
