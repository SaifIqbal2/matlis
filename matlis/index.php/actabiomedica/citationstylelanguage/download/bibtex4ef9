@article{Lorusso_Morelli_Colucci_Villanova_Greco_Lucarelli_Maggialetti_2026, place={Fidenza, Italy}, title={A decade of photon-counting CT research: Bibliometric trends and emerging themes}, volume={97}, url={https://mattioli1885journals.com/index.php/actabiomedica/article/view/18597}, DOI={10.23750/abm.2026.18597}, abstractNote={
Background and aim: Photon-counting computed tomography (PCCT) represents a significant advancement in medical imaging, offering improved spatial resolution, spectral imaging capabilities, and enhanced tissue characterization. This bibliometric analysis provides a comprehensive overview of PCCT research trends. Methods: A total of 1,390 articles were retrieved from the Scopus database without time restrictions. Articles were ranked based on citation count, and data extraction included title, authorship, publication year, journal impact, citation metrics, study design, funding sources, and subject classification. Results: Results indicate a rapid growth in PCCT-related publications, with the highest output recorded in 2024. The United States, Germany, and Switzerland emerged as leading contributors. Original research articles dominated (62.37%), followed by conference papers (14.68%) and review articles (12.23%). Keyword co-occurrence analysis highlighted major research themes, including spectral imaging, material decomposition, image quality, and artificial intelligence applications. The citation analysis revealed that foundational research on PCCT technology, image reconstruction, and artifact reduction has shaped the field. Conclusions: The study underscores the growing clinical relevance of PCCT, particularly in cardiovascular imaging, oncology, and musculoskeletal applications. (www.actabiomedica.it)
}, number={4}, journal={Acta Biomedica Atenei Parmensis}, author={Lorusso, Giovanni and Morelli, Chiara and Colucci, Eva and Villanova, Ilaria and Greco, Sara and Lucarelli, Nicola Maria and Maggialetti, Nicola}, year={2026}, month={Aug.}, pages={18597} }