@article{De Sanctis_Soliman_Alaaraj_Ahmed_Alyafei_Hamed_2021, place={Fidenza, Italy}, title={Early and Long-term Consequences of Nutritional Stunting: From Childhood to Adulthood: Early and Long-term Consequences of Nutritional Stunting}, volume={92}, url={https://mattioli1885journals.com/index.php/actabiomedica/article/view/11346}, DOI={10.23750/abm.v92i1.11346}, abstractNote={
Summary. Linear growth failure (stunting) in childhood is the most prevalent form of undernutrition globally. The debate continues as to whether children who become stunted before age 24 months can catch up in growth and cognitive functions later in their lives. The potentially irreparable physical and neurocognitive damage that accompanies stunted growth is a major obstacle to human development. This review aims at evaluation and summarizing the published research covering the different aspects of stunting from childhood to adulthood.
}, number={1}, journal={Acta Biomedica Atenei Parmensis}, author={De Sanctis, Vincenzo and Soliman, Ashraf and Alaaraj, Nada and Ahmed, Shayma and Alyafei, Fawziya and Hamed, Noor}, year={2021}, month={Feb.}, pages={11346} }