@article{Borggaard_Kildegaard_Laursen_Bhatnagar_Volpicelli_Pietersen_2026, place={Fidenza (PR), Italy}, title={Progress in lung ultrasound education: An updated systematic review}, volume={18}, url={https://mattioli1885journals.com/index.php/theultrasoundjournal/article/view/18361}, DOI={10.5826/tuj.2026.18361}, abstractNote={
Background: Thoracic ultrasound (TUS) is integrated into clinical practice across various medical specialties to aid with diagnosis and procedural safety. Significant variability in training approaches and standards exists between nations and individual centres. Aim and objectives: To review how differences in published TUS training methods impact upon learning. Methods: A literature search following PRISMA guidelines was conducted in Medline, Embase, Cochrane Library and Scopus, from Jan 2017 until May 2025. Studies involving TUS education using pre- and post-assessments of learning were included. Results: 12,460 studies were screened, 235 full texts assessed, and 68 were included in the review. Studies were mainly observational cohorts targeting different healthcare professionals. Ten randomized controlled trials, four non-randomized comparison and one switching replications evaluating different interventions were identified. Physicians were the primary audience in 65% while 29% focused on other healthcare professionals. Class-based teaching was the most common educational tool (66%) sometimes combined with web-based (16%). 84% of studies involved practical training, with training on humans alone (in 63% of cases). Most educational tools led to significant improvements in test scores, although assessment validity was rarely addressed. Conclusion: Our review confirms various TUS educational methods are used in heterogenous participants. While most interventions demonstrated positive learning effects, few studies addressed how this translates to safe clinical use.
}, number={1}, journal={The Ultrasound Journal}, author={Borggaard, Pernilla G. and Kildegaard, Christian and Laursen, Christian B. and Bhatnagar, Rahul and Volpicelli, Giovanni and Pietersen, Pia Iben}, year={2026}, month={May}, pages={18361} }