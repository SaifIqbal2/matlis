{
  "cleanUrls": false,
  "trailingSlash": false,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/auth", "destination": "/auth/index.html" },
    { "source": "/auth/", "destination": "/auth/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/archives", "destination": "/archives/index.html" },
    { "source": "/archives/", "destination": "/archives/index.html" },
    { "source": "/index.php/:journal/search/index", "destination": "/index.php/:journal/search.html" },
    { "source": "/index.php/:journal/search/index.html", "destination": "/index.php/:journal/search.html" }
  ],
  "redirects": [
    { "source": "/index.php/:journal/login", "destination": "/auth/?mode=login&journal=:journal", "permanent": false },
    { "source": "/index.php/:journal/login.html", "destination": "/auth/?mode=login&journal=:journal", "permanent": false },
    { "source": "/index.php/:journal/user/register", "destination": "/auth/?mode=register&journal=:journal", "permanent": false },
    { "source": "/index.php/:journal/user/register.html", "destination": "/auth/?mode=register&journal=:journal", "permanent": false },
    { "source": "/index.php/:journal/user/register4cef.html", "destination": "/auth/?mode=register&journal=:journal", "permanent": false },
    { "source": "/index.php/:journal/user/registerd976.html", "destination": "/auth/?mode=register&journal=:journal", "permanent": false }
  ]
}
